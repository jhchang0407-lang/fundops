# FundOps Environment Variables
# Copy this to .env and fill in your values

# Financial Modeling Prep API (market data, estimates, peers)
FMP_API_KEY=your_fmp_api_key_here

# OpenAI API (LLM for thesis generation, IC review, memo writing)
OPENAI_API_KEY=your_openai_api_key_here

# SEC EDGAR User Agent (required by SEC fair use policy)
SEC_USER_AGENT=FundOps/1.0 (your_email@example.com)
